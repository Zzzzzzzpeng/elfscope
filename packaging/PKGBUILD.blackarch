# BlackArch package template for ELFscope.
# Replace REPLACE_WITH_GITHUB_USER after publishing the project.

pkgname=elfscope
pkgver=0.1.0
pkgrel=1
pkgdesc='Static ELF triage utility for defensive reverse engineering'
arch=('any')
groups=('blackarch' 'blackarch-binary' 'blackarch-reversing')
url='https://github.com/REPLACE_WITH_GITHUB_USER/elfscope'
license=('MIT')
depends=('python' 'python-pyelftools')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
source=("git+https://github.com/REPLACE_WITH_GITHUB_USER/elfscope.git#tag=v$pkgver")
sha512sums=('SKIP')

build() {
  cd "$pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname"
  python -m pytest
}

package() {
  cd "$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
